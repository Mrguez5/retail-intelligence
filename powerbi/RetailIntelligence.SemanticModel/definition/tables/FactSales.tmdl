table FactSales
	lineageTag: b9187395-c774-5660-88b9-ad36e80e5b45

	measure 'Net Revenue' = SUM ( FactSales[NetRevenue] )
		formatString: €#,0
		displayFolder: Sales
		lineageTag: 75ddc5d9-f6ec-5caa-9b65-a5a8f6aceeb3

	measure 'Gross Margin' = SUM ( FactSales[Margin] )
		formatString: €#,0
		displayFolder: Sales
		lineageTag: 58ed39fa-dee2-5b74-9f75-52dbda4ebd10

	measure 'Gross Margin %' = DIVIDE ( [Gross Margin], [Net Revenue] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: d1ee43ca-e73a-5915-a205-ded6ec2a2ca1

	measure 'Units Sold' = CALCULATE ( SUM ( FactSales[Quantity] ), FactSales[IsReturn] = FALSE () )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 9b59b2c8-5249-554a-83cb-931e2019e9cf

	measure 'Units Returned' = - CALCULATE ( SUM ( FactSales[Quantity] ), FactSales[IsReturn] = TRUE () )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 75835945-48f6-558c-9234-ef31c9a5c3e8

	measure Orders = CALCULATE ( DISTINCTCOUNT ( FactSales[OrderKey] ), FactSales[IsReturn] = FALSE () )
		formatString: #,0
		displayFolder: Sales
		lineageTag: de9e63cc-c6c6-52a4-a46a-f2d2a2e15d93

	measure 'Avg Order Value' = DIVIDE ( [Net Revenue], [Orders] )
		formatString: €#,0.00
		displayFolder: Sales
		lineageTag: bb69cace-70f0-5572-af1b-924c90d4f12e

	measure 'Marketplace Commission' = SUM ( FactSales[Commission] )
		formatString: €#,0
		displayFolder: Sales
		lineageTag: e4010d62-ec74-5b09-8307-79ef9887453b

	measure 'Clean Lines' = COUNTROWS ( FactSales )
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 3ae35623-ae00-5a12-8afe-9788be3c592c

	measure 'Revenue Trend' =
			VAR MaxSaleDate = CALCULATE ( MAX ( FactSales[Date] ), REMOVEFILTERS ( DimDate ) )
			VAR CurStart = EOMONTH ( MaxSaleDate, -1 ) + 1
			VAR PrevStart = EOMONTH ( MaxSaleDate, -2 ) + 1
			VAR Cur = CALCULATE ( [Net Revenue], REMOVEFILTERS ( DimDate ), DimDate[Date] >= CurStart, DimDate[Date] <= EOMONTH ( MaxSaleDate, 0 ) )
			VAR Prev = CALCULATE ( [Net Revenue], REMOVEFILTERS ( DimDate ), DimDate[Date] >= PrevStart, DimDate[Date] < CurStart )
			VAR Delta = DIVIDE ( Cur - Prev, Prev )
			RETURN
			    IF ( ISBLANK ( Cur ) || ISBLANK ( Prev ), BLANK (),
			        IF ( Delta >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( Delta ), "0.0%" ) & "   " & FORMAT ( CurStart, "mmm" ) & " vs " & FORMAT ( PrevStart, "mmm" ) )
		displayFolder: Trends
		lineageTag: 266b65ee-ccf3-5e5a-8a16-8843eddb22b6

	measure 'Revenue Trend Color' =
			VAR MaxSaleDate = CALCULATE ( MAX ( FactSales[Date] ), REMOVEFILTERS ( DimDate ) )
			VAR CurStart = EOMONTH ( MaxSaleDate, -1 ) + 1
			VAR PrevStart = EOMONTH ( MaxSaleDate, -2 ) + 1
			VAR Cur = CALCULATE ( [Net Revenue], REMOVEFILTERS ( DimDate ), DimDate[Date] >= CurStart, DimDate[Date] <= EOMONTH ( MaxSaleDate, 0 ) )
			VAR Prev = CALCULATE ( [Net Revenue], REMOVEFILTERS ( DimDate ), DimDate[Date] >= PrevStart, DimDate[Date] < CurStart )
			VAR Delta = DIVIDE ( Cur - Prev, Prev )
			RETURN
			    IF ( ISBLANK ( Delta ), BLANK (), IF ( Delta >= 0, "#4ade80", "#f87171" ) )
		isHidden
		displayFolder: Formatting
		lineageTag: cd1920a5-ad1f-58fe-a2e9-7b2554c40f9b

	measure 'Margin Trend' =
			VAR MaxSaleDate = CALCULATE ( MAX ( FactSales[Date] ), REMOVEFILTERS ( DimDate ) )
			VAR CurStart = EOMONTH ( MaxSaleDate, -1 ) + 1
			VAR PrevStart = EOMONTH ( MaxSaleDate, -2 ) + 1
			VAR Cur = CALCULATE ( [Gross Margin %], REMOVEFILTERS ( DimDate ), DimDate[Date] >= CurStart, DimDate[Date] <= EOMONTH ( MaxSaleDate, 0 ) )
			VAR Prev = CALCULATE ( [Gross Margin %], REMOVEFILTERS ( DimDate ), DimDate[Date] >= PrevStart, DimDate[Date] < CurStart )
			VAR Delta = Cur - Prev
			RETURN
			    IF ( ISBLANK ( Cur ) || ISBLANK ( Prev ), BLANK (),
			        IF ( Delta >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( Delta ) * 100, "0.0" ) & " pp" & "   " & FORMAT ( CurStart, "mmm" ) & " vs " & FORMAT ( PrevStart, "mmm" ) )
		displayFolder: Trends
		lineageTag: e48cdec8-78c2-5225-8543-26f72b14b62a

	measure 'Margin Trend Color' =
			VAR MaxSaleDate = CALCULATE ( MAX ( FactSales[Date] ), REMOVEFILTERS ( DimDate ) )
			VAR CurStart = EOMONTH ( MaxSaleDate, -1 ) + 1
			VAR PrevStart = EOMONTH ( MaxSaleDate, -2 ) + 1
			VAR Cur = CALCULATE ( [Gross Margin %], REMOVEFILTERS ( DimDate ), DimDate[Date] >= CurStart, DimDate[Date] <= EOMONTH ( MaxSaleDate, 0 ) )
			VAR Prev = CALCULATE ( [Gross Margin %], REMOVEFILTERS ( DimDate ), DimDate[Date] >= PrevStart, DimDate[Date] < CurStart )
			VAR Delta = Cur - Prev
			RETURN
			    IF ( ISBLANK ( Delta ), BLANK (), IF ( Delta >= 0, "#4ade80", "#f87171" ) )
