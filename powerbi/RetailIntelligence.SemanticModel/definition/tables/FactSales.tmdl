	measure 'Margin Color' =
			VAR M = [Gross Margin %]
			RETURN SWITCH ( TRUE (), ISBLANK ( M ), BLANK (), M >= 0.36, "#15803d", M >= 0.33, "#b45309", "#b91c1c" )
		isHidden
		displayFolder: Formatting
		lineageTag: c62dfae3-9403-5486-996f-ec2f77c40a0f

