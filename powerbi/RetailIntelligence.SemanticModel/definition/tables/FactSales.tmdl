	partition FactSales = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "\FactSales.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"SaleLineId", type text}, {"Date", type date}, {"Channel", type text}, {"Sku", type text}, {"OrderKey", type text}, {"Quantity", Int64.Type}, {"UnitPrice", type number}, {"NetRevenue", type number}, {"Commission", type number}, {"Cogs", type number}, {"Margin", type number}, {"IsReturn", type logical}, {"MatchMethod", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
